{
	"name": "astro-theme-thought-lite",
	"type": "module",
	"private": true,
	"version": "0.42.0",
	"description": "A modern Astro theme focused on content creation",
	"keywords": [
		"astro",
		"theme",
		"blog",
		"svelte",
		"typescript",
		"i18n"
	],
	"homepage": "https://github.com/tuyuritio/astro-theme-thought-lite",
	"repository": {
		"type": "git",
		"url": "https://github.com/tuyuritio/astro-theme-thought-lite.git"
	},
	"bugs": {
		"url": "https://github.com/tuyuritio/astro-theme-thought-lite/issues"
	},
	"license": "GPL-3.0",
	"author": {
		"name": "tuyuritio",
		"url": "https://github.com/tuyuritio"
	},
	"packageManager": "pnpm@11.3.0",
	"scripts": {
		"new": "tsx --loader esm-loader-yaml scripts/new.ts",
		"dev": "astro dev",
		"check": "astro check",
		"build": "astro build",
		"preview": "astro preview",
		"format": "biome format --write",
		"lint": "biome lint",
		"count": "git log --pretty=tformat: --numstat | grep -v package | awk '{ A += $1; S += $2; T += $1 - $2 } END { printf \"+ %s\tLines\\n- %s\tLines\\n= %s\tLines\\n\", A, S, T }'",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.9",
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/sitemap": "^3.7.5",
		"@astrojs/svelte": "^9.1.6",
		"@hbsnow/rehype-sectionize": "^1.0.7",
		"@iconify-json/fa6-brands": "^1.2.6",
		"@iconify-json/lucide": "^1.2.155",
		"@iconify-json/simple-icons": "^1.2.102",
		"@iconify/tailwind4": "^1.2.3",
		"@swup/astro": "^1.8.0",
		"@tailwindcss/vite": "^4.3.5",
		"@tuyuritio/rehype-image-figure": "^1.0.0",
		"@tuyuritio/rehype-table-wrapper": "^1.0.1",
		"@tuyuritio/remark-abbreviation": "^1.0.0",
		"@tuyuritio/remark-attribute": "^1.0.0",
		"@tuyuritio/remark-github-alert": "^1.0.0",
		"@tuyuritio/remark-ruby": "^1.0.2",
		"@tuyuritio/remark-spoiler": "^0.0.2",
		"@tuyuritio/shiki-code-copy": "^1.0.0",
		"astro": "^7.4.12",
		"feed": "^6.0.0",
		"katex": "^0.19.1",
		"mdast-util-to-string": "^4.0.0",
		"medium-zoom": "^1.1.2",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-katex": "^7.0.1",
		"remark-cjk-friendly": "^2.3.4",
		"remark-cjk-friendly-gfm-strikethrough": "^2.3.3",
		"remark-extended-table": "^2.0.3",
		"remark-flexible-markers": "^1.3.6",
		"remark-footnotes-extra": "^0.3.0",
		"remark-gemoji": "^8.0.0",
		"remark-gfm": "^4.0.1",
		"remark-ins": "^1.2.6",
		"remark-math": "^6.0.0",
		"svelte": "^5.57.3",
		"tailwindcss": "^4.3.5",
		"temporal-polyfill": "^1.0.8",
		"typescript": "^6.0.3",
		"unified": "^11.0.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "2.6.8",
		"@clack/prompts": "^1.9.0",
		"@rollup/plugin-yaml": "^5.0.1",
		"@types/css-tree": "^3.2.0",
		"@types/mdast": "^4.0.4",
		"css-tree": "^3.2.1",
		"esm-loader-yaml": "^1.0.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1",
		"prettier": "3.10.1",
		"prettier-plugin-astro": "1.1.2",
		"prettier-plugin-svelte": "^4.1.1",
		"satori": "^0.63.2",
		"sharp": "^0.35.5",
		"tsx": "^4.23.15",
		"unifont": "^1.0.3"
	},
	"lint-staged": {
		"*.{js,ts,json,jsonc,css,svelte,astro}": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	}
}
