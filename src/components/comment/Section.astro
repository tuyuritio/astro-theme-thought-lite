---
import { comment, oauth, turnstile, push, email } from "$config";
import Comments from "./Section.svelte";

interface Props {
	locale: string;
	section: "note" | "jotting" | "preface";
	item: string;
	compact?: boolean;
}

const { locale, section, item, compact } = Astro.props;
---

<!-- Wrapping component to inject server-side environment variables -->
{comment && <Comments client:visible {locale} {section} {item} {oauth} {turnstile} {push} {email} {compact} />}
